# ============================================================
# MEDISAKHI AI - Environment Configuration Example
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ----------------------------
# APPLICATION
# ----------------------------
APP_NAME="MEDISAKHI AI"
APP_ENV=development
DEBUG=true
DEMO_MODE=true
DEFAULT_LANGUAGE=en

# ----------------------------
# DATABASE
# ----------------------------
# SQLite (default for local dev):
DATABASE_URL=sqlite:///./medisakhi.db

# PostgreSQL (for production):
# DATABASE_URL=postgresql://medisakhi_user:your_password@localhost:5432/medisakhi_db

# ----------------------------
# SECURITY
# ----------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ----------------------------
# AI / CHATBOT
# ----------------------------
# Set AI_PROVIDER to 'openai', 'gemini', or leave 'demo' for rule-based demo mode
AI_PROVIDER=demo
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ----------------------------
# OCR SERVICE
# ----------------------------
# Set OCR_PROVIDER to 'google', 'tesseract', or 'demo'
OCR_PROVIDER=demo
GOOGLE_CLOUD_VISION_API_KEY=
TESSERACT_CMD=tesseract

# ----------------------------
# SMS PROVIDER
# ----------------------------
# Set SMS_PROVIDER to 'twilio', 'msg91', or 'demo'
SMS_PROVIDER=demo
SMS_SENDER_ID=MEDISK

# Twilio (if SMS_PROVIDER=twilio):
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# MSG91 (if SMS_PROVIDER=msg91):
MSG91_API_KEY=
MSG91_SENDER_ID=

# Webhook secret for verifying incoming SMS webhooks
SMS_WEBHOOK_SECRET=

# ----------------------------
# EMAIL PROVIDER
# ----------------------------
EMAIL_PROVIDER=demo
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@medisakhi.ai

# ----------------------------
# VOICE / IVR (OPTIONAL)
# ----------------------------
VOICE_PROVIDER=demo
# Exotel or Twilio voice credentials here

# ----------------------------
# ESCALATION TIMING (minutes)
# ----------------------------
ESCALATION_DELAY_FOLLOWUP=10
ESCALATION_DELAY_CAREGIVER_PRIMARY=20
ESCALATION_DELAY_CAREGIVER_SECONDARY=30

# ----------------------------
# FRONTEND (set in frontend/.env)
# ----------------------------
# VITE_API_URL=http://localhost:8000/api/v1
